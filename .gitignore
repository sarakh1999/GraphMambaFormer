# --- large data -------------------------------------------------------------
# data/ holds ~71 GB of references, indexes, BAMs, FASTQs and DeepVariant
# intermediates. All of it is re-derivable: scripts/fig6/run_all.sh downloads
# and rebuilds everything from public GIAB/HPRC sources.
# Kept: data/hprc, the small sample-link manifests the README points at.
data/*
!data/hprc/
# Re-downloaded on demand by scripts/hprc/build_release2_table.py.
data/hprc/.cache_r2/

# --- local environment ------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
# Downloaded CLI binaries (gh, crane, longcallD) and throwaway Python envs the
# agent tooling installs locally: ~216 MB, all re-fetchable.
.tools/
.tools_py/

# --- not redistributable ----------------------------------------------------
papers/
meetings screenshots/
# The architecture spec and its screenshots are reference material, not code:
# the exported HTML plus ~24 MB of PNGs that duplicate it. scripts/audit_architecture.py
# encodes the numbers it checks, so it does not read these at runtime.
architecture/*.html
architecture/*.png
# NVIDIA brand artwork used only when rebuilding the deck.
architecture/nvidia_assets/
# Exported slide deck: a binary rebuild artifact of the same material.
# architecture/build_pptx.py regenerates it.
architecture/*.pptx

# --- stray genomics artifacts outside data/ ---------------------------------
*.bam
*.bam.bai
*.bai
*.cram
*.crai
*.sam
*.fastq
*.fastq.gz
*.fq.gz
*.fa
*.fai
*.fasta
*.fasta.gz
*.vcf
*.vcf.gz
*.tbi
*.gbz
*.gfa
*.vg
*.dist
*.min
*.zipcodes
*.tfrecord.gz

# --- model checkpoints / generated datasets ---------------------------------
*.pt
*.pth
*.ckpt

# --- os / editor ------------------------------------------------------------
.DS_Store
*.swp

# --- agent scratch / transient build & review artifacts ---------------------
# Cursor agent scratch files, local build output, throwaway review logs, and
# manifest backups. All transient and re-derivable.
.cursor_tmp_*
build/
tmp_agnes_review/
*.bak
# WFA-GPU is cloned on demand by scripts/build_wfa_gpu.sh (nested git repo).
third_party/
